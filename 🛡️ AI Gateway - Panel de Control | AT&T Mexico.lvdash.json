{
  "datasets": [
    {
      "name": "aigw_total_tokens",
      "displayName": "Total Tokens",
      "queryLines": [
        "SELECT\n",
        "  SUM(total_tokens) as tokens\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_total_requests",
      "displayName": "Total Requests",
      "queryLines": [
        "SELECT\n",
        "  count(*) as total_requests\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_bloqueados",
      "displayName": "Requests Bloqueados",
      "queryLines": [
        "SELECT\n",
        "  count(*) as bloqueados\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'\n",
        "  AND status_code != 200"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_consumo_modelo",
      "displayName": "Consumo por Modelo",
      "queryLines": [
        "SELECT\n",
        "  endpoint_name,\n",
        "  SUM(total_tokens) as total_tokens\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  total_tokens DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_requests_hora",
      "displayName": "Requests por Hora",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('hour', event_time) as hora,\n",
        "  CAST(status_code AS STRING) as status_code,\n",
        "  count(*) as total_requests\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'\n",
        "GROUP BY\n",
        "  1,\n",
        "  2\n",
        "ORDER BY\n",
        "  1"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_status_dist",
      "displayName": "Distribución de Status",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN status_code = 200 THEN 'Exitoso'\n",
        "    WHEN status_code = 429 THEN 'Rate Limited'\n",
        "    WHEN status_code = 400 THEN 'Bloqueado'\n",
        "    ELSE 'Error'\n",
        "  END as status,\n",
        "  count(*) as total\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'\n",
        "GROUP BY\n",
        "  1"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_top_usuarios",
      "displayName": "Top Usuarios por Tokens",
      "queryLines": [
        "SELECT\n",
        "  requester,\n",
        "  SUM(total_tokens) as total_tokens\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  total_tokens DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "aigw_recent_requests",
      "displayName": "Últimos Requests",
      "queryLines": [
        "SELECT\n",
        "  date_format(event_time, 'yyyy-MM-dd HH:mm:ss') as fecha,\n",
        "  endpoint_name as modelo,\n",
        "  requester as usuario,\n",
        "  destination_name as destino,\n",
        "  status_code,\n",
        "  input_tokens,\n",
        "  output_tokens,\n",
        "  total_tokens\n",
        "FROM\n",
        "  system.ai_gateway.usage\n",
        "WHERE\n",
        "  event_time >= :date_range.min\n",
        "  AND event_time <= :date_range.max\n",
        "  AND requester LIKE '%moises.santos%'\n",
        "ORDER BY\n",
        "  event_time DESC\n",
        "LIMIT 25"
      ],
      "parameters": [
        {
          "displayName": "Date Range",
          "keyword": "date_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    }
  ],
